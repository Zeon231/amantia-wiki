{
  "name": "amantia-wiki",
  "compatibility_date": "2026-06-07",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // WIKI_USERS credentials store. Created once via:
  //   npx wrangler kv namespace create USERS_KV
  // Paste the printed `id` (and preview_id if given) below. On first admin
  // request after deploy, the Worker seeds this from the existing WIKI_USERS
  // secret so the migration is one-shot and reversible.
  "kv_namespaces": [
    { "binding": "USERS_KV", "id": "PASTE_KV_ID_HERE" }
  ]
}
