.DS_Store
.gitignore
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
# anchored to repo root only — do NOT ignore content/private/ (our gated publish target)
/private/
.replit
replit.nix
# .quartz/ plugins are VENDORED into the repo to skip the ~3-5 min
# install-plugins step on every Cloudflare Pages build. Nested build
# artifacts stay ignored; the disabled `latex` plugin (29 MB) is skipped
# so it doesn't bloat the commit.
.quartz/plugins/*/node_modules/
.quartz/plugins/*/.git/
.quartz/plugins/latex/
quartz/cli/tui/dist/
Thumbs.db
*.log
